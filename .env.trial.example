# Trial Mode — build-time presentation only. Copy to `.env.trial` and build with
#   npm run build -- --mode trial
# or export these variables before `npm run build`.
#
# SECURITY: these values are a user-experience gate, not access control. They
# are compiled into the bundle and evaluated in the browser, so a device clock
# or an edited file defeats them. Real expiry of access is enforced where the
# files are served (Cloudflare Access, a signed URL with a deadline, HTTP auth,
# or removing the deployment). See docs/TRIAL_BUILD_AND_RUN.md.
#
# Every value below is fictional. Never put a real customer name, a secret, a
# token or a personal address in this file or in `.env.trial`.

# Turn the trial presentation on. Anything other than `true` keeps the
# application exactly as it behaves without a trial.
VITE_TRIAL_MODE=true

# The company the trial was prepared for, as it should appear on screen.
VITE_TRIAL_COMPANY=Example Contracting Company

# Inclusive window, YYYY-MM-DD, read as calendar days in Asia/Riyadh.
# Seven days means the start day plus six.
VITE_TRIAL_START_DATE=2027-01-05
VITE_TRIAL_END_DATE=2027-01-11

# Cloud backend (Phase 2C) — copy to .env.local and fill in.
#
# Leave both empty, or delete the file, to keep the local-only build: the data
# stays in the browser and no sign-in is asked for.
#
# Both values are public by design. The anon key grants nothing on its own;
# row-level security decides what the signed-in user may read. Never put a
# service-role key in a VITE_ variable: everything VITE_ ships in the bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
